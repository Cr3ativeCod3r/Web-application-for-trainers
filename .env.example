DOMAIN=

# === Django Superuser (Admin) Setup ===
# The email address for the initial admin account (e.g., admin@example.com)
ADMIN_EMAIL=
# The password for the initial admin account
ADMIN_PASSWORD=

# === Email Configuration (SMTP) ===
# Your email address used for sending emails (e.g., your_email@gmail.com)
EMAIL_HOST_USER=
# Your email password. For Gmail, use an "App Password" (requires 2FA enabled), NOT your normal password.
EMAIL_HOST_PASSWORD=

# === Django Base Settings ===
# Django security key. REQUIRED - the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Debug mode (defaults to False; set True for local development only)
DEBUG=True
# Comma-separated host names the app may be served under
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for CSRF (needed behind HTTPS proxies), e.g. https://coachly.pl
CSRF_TRUSTED_ORIGINS=

# === PostgreSQL Database Credentials ===
# PostgreSQL database name
DB_NAME=trainapp
# Database user name
DB_USER=trainuser
# Database password
DB_PASS=trainpass
# Database host (127.0.0.1 for local run, or "db" when using Docker Compose)
DB_HOST=127.0.0.1
# Database port
DB_PORT=5432

# === Redis & Celery Configuration ===
# URL to connect to the Redis server (e.g., redis://127.0.0.1:6379/0 for local connection)
REDIS_URL=redis://127.0.0.1:6379/0

# === Google Gemini AI ===
# API key for the AI Coach feature. Get it from: https://aistudio.google.com/app/apikey
API_GEMINI=

# === Google OAuth 2.0 (Social Login) ===
# Client ID for Google Login. Get it from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
# Client Secret for Google Login. Get it from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_SECRET=

# === Cloudflare R2 Storage ===
# Set to True to enable saving media files to Cloudflare R2
USE_R2=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional: Set this if you use a custom domain or a public R2.dev domain (e.g., cdn.twojadomena.pl or pub-xxx.r2.dev)
R2_CUSTOM_DOMAIN=

# === Chat Microservice ===
# Password of the chat service's own PostgreSQL database (docker-compose service chat_db)
CHAT_DB_PASS=chat
CHAT_API_URL=http://localhost:8001
CHAT_WS_URL=ws://localhost:8001
# Comma-separated origins allowed to call the chat API from the browser
CHAT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Log every SQL statement of the chat service (development only)
SQL_ECHO=False
